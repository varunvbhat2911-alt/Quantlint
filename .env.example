# Supabase — required environment variables
# URL: Supabase Dashboard -> Settings -> Data API (Project URL)
# Key: Supabase Dashboard -> Settings -> API Keys (publishable key)
NEXT_PUBLIC_SUPABASE_URL=https://uehkniyiqjmtjqjsgerf.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_YOUR_PUBLISHABLE_KEY

# Server-only (Phase 2): service-role key for audit API writes while RLS has
# no policies. NEVER commit; NEVER reference from client code.
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_YOUR_SERVICE_ROLE_KEY

# Fireworks AI (Phase 3) — server-only. NEVER use NEXT_PUBLIC_FIREWORKS_API_KEY.
FIREWORKS_API_KEY=REPLACE_WITH_FIREWORKS_API_KEY
FIREWORKS_MODEL=accounts/fireworks/models/deepseek-v4-flash-0731

# Optional AI tuning (defaults shown)
# AI_TEMPERATURE=0.2
# AI_MAX_TOKENS=1500
# AI_TIMEOUT_MS=30000
# AI_MAX_ATTEMPTS=2
# AI_MAX_FINDINGS=10
# AI_MAX_CONTEXT_CHARS=6000
